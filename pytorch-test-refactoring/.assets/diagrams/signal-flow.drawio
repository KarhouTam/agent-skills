                <mxCell id="code-content2" value="&lt;font face=&quot;monospace&quot; style=&quot;font-size:12px&quot; color=&quot;#a5d6ff&quot;&gt;flow = RefactorFlow()&lt;br&gt;state = flow.run(&quot;test/test_ops.py&quot;)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#ff9&quot;&gt;while&lt;/font&gt; state.signal.value != &lt;font color=&quot;#9f9&quot;&gt;&quot;done&quot;&lt;/font&gt;:&lt;br&gt;    &lt;font color=&quot;#ff9&quot;&gt;if&lt;/font&gt; state.signal == SPAWN_SINGLE:&lt;br&gt;        agent_id, result = spawn_agent(...)&lt;br&gt;        flow.feed_agent_spawned(name, agent_id)&lt;br&gt;        flow.feed_analyst_result(result)&lt;br&gt;    &lt;font color=&quot;#ff9&quot;&gt;elif&lt;/font&gt; state.signal == SEND_MESSAGE:&lt;br&gt;        SendMessage(to=agent_id, msg=...)&lt;br&gt;        flow.feed_coder_result(&quot;coder&quot;, result)&lt;br&gt;    &lt;font color=&quot;#ff9&quot;&gt;elif&lt;/font&gt; state.signal == RELAY_FINDINGS:&lt;br&gt;        SendMessage(to=coder_agent_id, msg=... )&lt;br&gt;        flow.feed_fix_complete()&lt;br&gt;    state = flow.run(state.file_path)&lt;br&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" parent="1" vertex="1">
