# Only self-developed skills and repo tooling are version-controlled.
# Public skills are fetched into this directory by sync_skills.py and are
# deliberately untracked.
/*
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/README.md
!/skills.json
!/sync_skills.py
!/overlays/
!/adversarial-review/
!/context7-mcp/
!/deepwiki/
!/gh-github-cli/
!/mermaid-diagrams/
!/pytorch-test-refactoring/
!/tavily-web-access/
!/teaching-technical-topics/
!/triaging-pytorch-issues/
/triaging-pytorch-issues/target.md
# Runtime reports land here only when no pytorch/pytorch checkout is reachable.
/triaging-pytorch-issues/pytorch-triage-*.md
!/triaging-vllm-issues/
